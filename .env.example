# ==============================================================================
# DERMAClass-Net Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure with your actual credentials:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Gmail SMTP Configuration (Secure STARTTLS on Port 587)
# ------------------------------------------------------------------------------
# Instructions to set up Gmail SMTP:
# 1. Sign in to your Google Account (https://myaccount.google.com/).
# 2. Go to "Security" -> Enable "2-Step Verification" if not already enabled.
# 3. Under "2-Step Verification", navigate to "App passwords"
#    (Direct link: https://myaccount.google.com/apppasswords).
# 4. Generate a new App Password (e.g. app name: "DermaClass-Net").
# 5. Copy the 16-character App Password (e.g. "abcd efgh ijkl mnop").
# 6. Paste your Gmail address into SMTP_USERNAME and the 16-character password
#    into SMTP_PASSWORD below.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=DermaClass-Net

# ------------------------------------------------------------------------------
# OTP Security & Verification Settings
# ------------------------------------------------------------------------------
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN=60

# ------------------------------------------------------------------------------
# Platform Security & JWT Sessions
# ------------------------------------------------------------------------------
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Database Connection URL
# ------------------------------------------------------------------------------
# Default: SQLite database in workspace root
# PostgreSQL: postgresql://username:password@localhost:5432/dermaclass_db
# MySQL: mysql+pymysql://root:password@localhost:3306/dermaclass_db
DATABASE_URL=sqlite:///./database.sqlite

# ------------------------------------------------------------------------------
# Server Environment & Host
# ------------------------------------------------------------------------------
ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Frontend Vercel Environment (set in Vercel Project Settings)
# ------------------------------------------------------------------------------
# URL of your Render backend web service:
# VITE_API_BASE_URL=https://skiniq-backend.onrender.com
VITE_API_BASE_URL=
